{
  "name": "cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p web",
    "test": "npm run build && node --test --test-concurrency=1 src/*.test.ts",
    "build": "vite build",
    "e2e": "npm run build && node e2e/ui.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "playwright": "1.63.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "wrangler": "^4"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
